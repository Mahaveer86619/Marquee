# Marquee secrets
#
# Copy this file to deploy/.env and fill in the values you have. deploy/.env
# is ignored by git and is read only by the core container. Leave a value
# empty to disable that provider. Run `marquee doctor` to see which keys the
# core received; it reports only whether a key is set, never its value.
#
# Settings that are not secret (library folder, languages, Prowlarr on/off)
# live in <user home>/marquee-data/config.json, created by `marquee setup`.
# After changing this file, run `marquee up` to apply it.

# ---------------------------------------------------------------------------
# Used by the first slice (search, download, play)
# ---------------------------------------------------------------------------

# TMDB credentials. Enable film search, posters and full metadata. Series
# search works without them through TVmaze. One of the two is enough; when
# both are set, the Read Access Token is used.
# Get them: themoviedb.org > Settings > API > Request an API key (Developer,
# personal use). The page then shows both values.
#
# API Read Access Token: the long value starting with "eyJ" (recommended).
MARQUEE_TMDB_READ_ACCESS_TOKEN=
# API Key: the short 32-character value.
MARQUEE_TMDB_TOKEN=

# Prowlarr API key. Only needed when Prowlarr is enabled
# (scripts/full-up.ps1 -WithIndexers).
# Get it: open http://127.0.0.1:9696 > Settings > General > API Key.
MARQUEE_PROWLARR_API_KEY=

# ---------------------------------------------------------------------------
# Optional: online subtitle providers (used after the first slice; embedded
# subtitles need no key)
# ---------------------------------------------------------------------------

# OpenSubtitles.com: create a consumer (API key) at
# opensubtitles.com > Profile > API consumers. The username and password
# raise the daily download quota from 5 (anonymous) to 20 (free account).
MARQUEE_OPENSUBTITLES_API_KEY=
MARQUEE_OPENSUBTITLES_USERNAME=
MARQUEE_OPENSUBTITLES_PASSWORD=

# SubDL: register at subdl.com and copy the API key from the account panel.
MARQUEE_SUBDL_API_KEY=

# ---------------------------------------------------------------------------
# Optional: extra metadata
# ---------------------------------------------------------------------------

# TheTVDB v4 API key (thetvdb.com > Dashboard > API Keys). Improves episode
# ordering for some series. Not required.
MARQUEE_TVDB_API_KEY=

# OMDb API key (omdbapi.com/apikey.aspx). Adds IMDb and Rotten Tomatoes
# ratings. Not required.
MARQUEE_OMDB_API_KEY=

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Time zone for container logs and schedules, e.g. Asia/Kolkata.
TZ=Etc/UTC
